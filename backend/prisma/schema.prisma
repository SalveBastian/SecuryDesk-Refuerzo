generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALISTA
  CONSULTA
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(CONSULTA)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  incidents    Incident[] @relation("IncidentReporter")
}

model Incident {
  id            Int            @id @default(autoincrement())
  title         String         @db.VarChar(120)
  description   String         @db.VarChar(1000)
  severity      Severity
  status        IncidentStatus @default(OPEN)
  reporterEmail String         @db.VarChar(180)
  reporterId    Int?
  reporter      User?          @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([severity])
  @@index([status])
  @@index([createdAt])
}
